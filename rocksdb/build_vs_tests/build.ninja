  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Project\rocksdb\build_vs_tests\db_stress_tool && D:\Cmake\bin\ctest.exe "
  DESC = Running tests...
  pool = console
  restat = 1

build db_stress_tool\test: phony db_stress_tool\CMakeFiles\test.util


