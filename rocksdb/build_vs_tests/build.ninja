#############################################
# Utility command for tools

build tools: phony


#############################################
# Utility command for test

build CMakeFiles\test.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Project\rocksdb\build_vs_tests && D:\Cmake\bin\ctest.exe "
  DESC = Running tests...
  pool = console
  restat = 1

build test: phony CMakeFiles\test.util


#############################################
# Utility command for edit_cache

build CMakeFiles\edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Project\rocksdb\build_vs_tests && D:\Cmake\bin\cmake-gui.exe -SD:\Project\rocksdb -BD:\Project\rocksdb\build_vs_tests"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles\edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles\rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Project\rocksdb\build_vs_tests && D:\Cmake\bin\cmake.exe --regenerate-during-build -SD:\Project\rocksdb -BD:\Project\rocksdb\build_vs_tests"
