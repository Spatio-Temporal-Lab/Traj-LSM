  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Project\rocksdb\build_vs_tests\db_stress_tool && D:\Cmake\bin\cmake.exe --regenerate-during-build -SD:\Project\rocksdb -BD:\Project\rocksdb\build_vs_tests"
  DESC = Running CMake to regenerate build system...
