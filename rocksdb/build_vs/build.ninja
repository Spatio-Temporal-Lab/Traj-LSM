#############################################
# Utility command for edit_cache

build tools\CMakeFiles\edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Project\rocksdb\build_vs\tools && D:\Cmake\bin\cmake-gui.exe -SD:\Project\rocksdb -BD:\Project\rocksdb\build_vs"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build tools\edit_cache: phony tools\CMakeFiles\edit_cache.util


#############################################
# Utility command for rebuild_cache

build tools\CMakeFiles\rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Project\rocksdb\build_vs\tools && D:\Cmake\bin\cmake.exe --regenerate-during-build -SD:\Project\rocksdb -BD:\Project\rocksdb\build_vs"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tools\rebuild_cache: phony tools\CMakeFiles\rebuild_cache.util


#############################################
# Custom command for tools\CMakeFiles\ldb_tests

build tools\CMakeFiles\ldb_tests | ${cmake_ninja_workdir}tools\CMakeFiles\ldb_tests: CUSTOM_COMMAND tools\ldb.exe || rocksdb.lib tools\ldb.exe
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Project\rocksdb\build_vs\tools && python D:/Project/rocksdb/tools/ldb_tests.py"

