 namespace {
+constexpr uint32_t kGlobalSegmentValueMagicV2 = 0x32676553;
+constexpr uint32_t kGlobalSegmentValueMagicV3 = 0x33676553;
+constexpr uint8_t kGlobalSegmentValueFlagGhost = 0x01;
+
+#pragma pack(push, 1)
+struct GlobalSegmentValueHeader {
+  uint32_t t_start;
+  uint32_t t_end;
+  float x_min;
+  float y_min;
+  float x_max;
+  float y_max;
+  uint32_t point_count;
+};
+#pragma pack(pop)
+
+static_assert(sizeof(GlobalSegmentValueHeader) == 28,
+              "global segment header size");
+
+struct DecodedGlobalSegmentValue {
+  GlobalSegmentValueHeader header{};
+  bool is_legacy = false;
+  bool is_ghost = false;
+  bool has_inline_points = false;
+  std::string master_key;
+};
+
+bool IsGlobalSegmentUserKey(const Slice& user_key) {
+  if (user_key.size() < 1) {
+    return false;
+  }
+  const unsigned char magic =
+      static_cast<unsigned char>(user_key.data()[0]);
+  return magic == kSpatioTemporalSegmentKeyLegacyMagic ||
+         magic == kSpatioTemporalSegmentKeyTzidMagic;
+}
+
+bool DecodeGlobalSegmentValue(const Slice& value, DecodedGlobalSegmentValue* out) {
+  if (out == nullptr) {
+    return false;
+  }
+  *out = DecodedGlobalSegmentValue{};
+  if (value.size() == sizeof(GlobalSegmentValueHeader)) {
+    std::memcpy(&out->header, value.data(), sizeof(GlobalSegmentValueHeader));
+    out->is_legacy = true;
+    return true;
+  }
+  if (value.size() < 4 + sizeof(GlobalSegmentValueHeader)) {
+    return false;
+  }
+  uint32_t magic = 0;
+  std::memcpy(&magic, value.data(), 4);
+  if (magic != kGlobalSegmentValueMagicV2 &&
+      magic != kGlobalSegmentValueMagicV3) {
+    return false;
+  }
+  if (magic == kGlobalSegmentValueMagicV2) {
+    std::memcpy(&out->header, value.data() + 4, sizeof(GlobalSegmentValueHeader));
+    const size_t expected =
+        4 + sizeof(GlobalSegmentValueHeader) +
+        static_cast<size_t>(out->header.point_count) * 12;
+    if (value.size() != expected) {
+      return false;
+    }
+    out->has_inline_points = true;
+    return true;
+  }
+  if (value.size() < 4 + sizeof(GlobalSegmentValueHeader) + 1 + 4) {
+    return false;
+  }
+  size_t off = 4;
+  std::memcpy(&out->header, value.data() + off, sizeof(GlobalSegmentValueHeader));
+  off += sizeof(GlobalSegmentValueHeader);
+  const uint8_t flags = static_cast<uint8_t>(value.data()[off]);
+  off += 1;
+  uint32_t master_key_len = 0;
+  std::memcpy(&master_key_len, value.data() + off, 4);
+  off += 4;
+  if (off + static_cast<size_t>(master_key_len) > value.size()) {
+    return false;
+  }
+  out->is_ghost = ((flags & kGlobalSegmentValueFlagGhost) != 0);
+  if (master_key_len > 0) {
+    out->master_key.assign(value.data() + off, master_key_len);
+  }
+  off += master_key_len;
+  const size_t points_bytes =
+      static_cast<size_t>(out->header.point_count) * 12;
+  const size_t remaining = value.size() - off;
+  if (out->is_ghost) {
+    if (remaining != 0 && remaining != points_bytes) {
+      return false;
+    }
+  } else if (remaining != points_bytes) {
+    return false;
+  }
+  out->has_inline_points = (remaining == points_bytes);
+  if (out->is_ghost && out->master_key.empty()) {
+    return false;
+  }
+  return true;
+}
+
+bool GlobalSegmentHeadersMatch(const GlobalSegmentValueHeader& a,
+                               const GlobalSegmentValueHeader& b) {
+  return a.t_start == b.t_start && a.t_end == b.t_end &&
+         a.point_count == b.point_count &&
+         std::memcmp(&a.x_min, &b.x_min, sizeof(float)) == 0 &&
+         std::memcmp(&a.y_min, &b.y_min, sizeof(float)) == 0 &&
+         std::memcmp(&a.x_max, &b.x_max, sizeof(float)) == 0 &&
+         std::memcmp(&a.y_max, &b.y_max, sizeof(float)) == 0;
+}
+
+Status GlobalRawLookupByKey(DBImpl* db, const ReadOptions& read_options,
+                            ColumnFamilyHandle* column_family,
+                            const Slice& key, std::string* value_out) {
+  assert(db != nullptr);
+  assert(column_family != nullptr);
+  assert(value_out != nullptr);
+  value_out->clear();
+
+  PinnableSlice raw(value_out);
+  DBImpl::GetImplOptions opts;
+  opts.column_family = column_family;
+  opts.value = &raw;
+  Status s = db->GetImpl(read_options, key, opts);
+  if (s.ok()) {
+    if (raw.IsPinned()) {
+      value_out->assign(raw.data(), raw.size());
+    }
+    return s;
+  }
+
+  ReadOptions fallback_ro(read_options);
+  fallback_ro.total_order_seek = true;
+  std::unique_ptr<Iterator> it(db->DBImpl::NewIterator(fallback_ro, column_family));
+  it->Seek(key);
+  if (!it->Valid()) {
+    return it->status().ok() ? s : it->status();
+  }
+  if (it->key().compare(key) != 0) {
+    return s;
+  }
+  value_out->assign(it->value().data(), it->value().size());
+  return Status::OK();
+}
+
+Status MaybeMaterializeGlobalSegmentValue(
+    DBImpl* db, const ReadOptions& read_options, ColumnFamilyHandle* column_family,
+    const Slice& user_key, const Slice& raw_value, bool enable_verify_ghost,
+    std::string* materialized_value, std::string* canonical_key,
+    bool* was_ghost, bool* applicable) {
+  assert(materialized_value != nullptr);
+  assert(canonical_key != nullptr);
+  assert(was_ghost != nullptr);
+  assert(applicable != nullptr);
+  materialized_value->clear();
+  canonical_key->clear();
+  *was_ghost = false;
+  *applicable = false;
+  if (!IsGlobalSegmentUserKey(user_key)) {
+    return Status::OK();
+  }
+
+  DecodedGlobalSegmentValue decoded;
+  const bool e7_key =
+      user_key.size() > 0 &&
+      static_cast<unsigned char>(user_key.data()[0]) ==
+          kSpatioTemporalSegmentKeyTzidMagic;
+  const bool key_says_ghost = e7_key && IsE7GhostByKeyType(user_key);
+  if (e7_key && !key_says_ghost) {
+    // Key-first routing for E7: non-ghost can return immediately.
+    *applicable = true;
+    *was_ghost = false;
+    canonical_key->assign(user_key.data(), user_key.size());
+    return Status::OK();
+  }
+  if (!DecodeGlobalSegmentValue(raw_value, &decoded)) {
+    return Status::OK();
+  }
+  *applicable = true;
+  *was_ghost = e7_key ? key_says_ghost : decoded.is_ghost;
+  if (e7_key && key_says_ghost && !decoded.is_ghost) {
+    return Status::Corruption("E7 key marks ghost but value is not ghost");
+  }
+  if (!decoded.is_ghost) {
+    canonical_key->assign(user_key.data(), user_key.size());
+    return Status::OK();
+  }
+  canonical_key->assign(decoded.master_key);
+  if (decoded.has_inline_points) {
+    materialized_value->assign(raw_value.data(), raw_value.size());
+    return Status::OK();
+  }
+
+  std::string master_value;
+  Status s = GlobalRawLookupByKey(db, read_options, column_family,
+                                  Slice(decoded.master_key), &master_value);
+  if (!s.ok()) {
+    return s;
+  }
+  DecodedGlobalSegmentValue master_decoded;
+  if (!DecodeGlobalSegmentValue(Slice(master_value), &master_decoded)) {
+    return Status::Corruption("Global master decode failed");
+  }
+  if (master_decoded.is_ghost) {
+    return Status::Corruption("Global master resolved to ghost");
+  }
+  if (enable_verify_ghost &&
+      !GlobalSegmentHeadersMatch(decoded.header, master_decoded.header)) {
+    return Status::Corruption("Global ghost/master metadata mismatch");
+  }
+  materialized_value->swap(master_value);
+  return Status::OK();
+}
+
+class GlobalMaterializingIterator : public Iterator {
+ public:
+  GlobalMaterializingIterator(DBImpl* db, std::unique_ptr<Iterator>&& inner,
+                              ColumnFamilyHandle* column_family,
+                              const ReadOptions& read_options,
+                              bool enable_verify_ghost)
+      : db_(db),
+        inner_(std::move(inner)),
+        column_family_(column_family),
+        read_options_(read_options),
+        enable_verify_ghost_(enable_verify_ghost) {}
+
+  bool Valid() const override { return status_.ok() && inner_->Valid(); }
+  void SeekToFirst() override {
+    direction_ = Direction::kForward;
+    seen_reverse_.clear();
+    ResetCurrent();
+    inner_->SeekToFirst();
+    AdvanceToVisibleForward();
+  }
+  void SeekToLast() override {
+    direction_ = Direction::kReverse;
+    seen_forward_.clear();
+    ResetCurrent();
+    inner_->SeekToLast();
+    AdvanceToVisibleBackward();
+  }
+  void Seek(const Slice& target) override {
+    direction_ = Direction::kForward;
+    seen_forward_.clear();
+    seen_reverse_.clear();
+    ResetCurrent();
+    inner_->Seek(target);
+    AdvanceToVisibleForward();
+  }
+  void SeekForPrev(const Slice& target) override {
+    direction_ = Direction::kReverse;
+    seen_forward_.clear();
+    seen_reverse_.clear();
+    ResetCurrent();
+    inner_->SeekForPrev(target);
+    AdvanceToVisibleBackward();
+  }
+  void Next() override {
+    assert(Valid());
+    if (direction_ != Direction::kForward) {
+      direction_ = Direction::kForward;
+      seen_forward_.clear();
+    }
+    seen_reverse_.clear();
+    ResetCurrent();
+    inner_->Next();
+    AdvanceToVisibleForward();
+  }
+  void Prev() override {
+    assert(Valid());
+    if (direction_ != Direction::kReverse) {
+      direction_ = Direction::kReverse;
+      seen_reverse_.clear();
+    }
+    seen_forward_.clear();
+    ResetCurrent();
+    inner_->Prev();
+    AdvanceToVisibleBackward();
+  }
+  Slice key() const override { return inner_->key(); }
+  Slice value() const override {
+    assert(Valid());
+    if (current_materialized_) {
+      return Slice(materialized_value_);
+    }
+    return inner_->value();
+  }
+  const WideColumns& columns() const override { return inner_->columns(); }
+  Status status() const override {
+    if (!status_.ok()) {
+      return status_;
+    }
+    return inner_->status();
+  }
+  Status Refresh() override {
+    ResetAll();
+    return inner_->Refresh();
+  }
+  Status Refresh(const Snapshot* snapshot) override {
+    ResetAll();
+    return inner_->Refresh(snapshot);
+  }
+  bool PrepareValue() override {
+    if (!inner_->PrepareValue()) {
+      status_ = inner_->status();
+      return false;
+    }
+    return PrepareCurrent();
+  }
+  Status GetProperty(std::string prop_name, std::string* prop) override {
+    return inner_->GetProperty(std::move(prop_name), prop);
+  }
+  Slice timestamp() const override { return inner_->timestamp(); }
+
+ private:
+  enum class Direction { kUnknown, kForward, kReverse };
+
+  void ResetCurrent() {
+    current_prepared_ = false;
+    current_materialized_ = false;
+    current_applicable_ = false;
+    current_was_ghost_ = false;
+    materialized_value_.clear();
+    canonical_key_.clear();
+  }
+
+  void ResetAll() {
+    status_ = Status::OK();
+    direction_ = Direction::kUnknown;
+    seen_forward_.clear();
+    seen_reverse_.clear();
+    ResetCurrent();
+  }
+
+  bool PrepareCurrent() {
+    if (current_prepared_ || !inner_->Valid() || !status_.ok()) {
+      return status_.ok();
+    }
+    Status s = MaybeMaterializeGlobalSegmentValue(
+        db_, read_options_, column_family_, inner_->key(), inner_->value(),
+        enable_verify_ghost_, &materialized_value_, &canonical_key_,
+        &current_was_ghost_, &current_applicable_);
+    if (!s.ok()) {
+      status_ = s;
+      return false;
+    }
+    current_materialized_ = !materialized_value_.empty();
+    current_prepared_ = true;
+    return true;
+  }
+
+  void AdvanceToVisibleForward() {
+    while (status_.ok() && inner_->Valid()) {
+      if (!PrepareCurrent()) {
+        return;
+      }
+      if (!current_applicable_) {
+        return;
+      }
+      const std::string& canonical =
+          canonical_key_.empty() ? inner_->key().ToString() : canonical_key_;
+      if (seen_forward_.insert(canonical).second) {
+        return;
+      }
+      ResetCurrent();
+      inner_->Next();
+    }
+  }
+
+  void AdvanceToVisibleBackward() {
+    while (status_.ok() && inner_->Valid()) {
+      if (!PrepareCurrent()) {
+        return;
+      }
+      if (!current_applicable_) {
+        return;
+      }
+      const std::string& canonical =
+          canonical_key_.empty() ? inner_->key().ToString() : canonical_key_;
+      if (seen_reverse_.insert(canonical).second) {
+        return;
+      }
+      ResetCurrent();
+      inner_->Prev();
+    }
+  }
+
+  DBImpl* db_;
+  std::unique_ptr<Iterator> inner_;
+  ColumnFamilyHandle* column_family_;
+  ReadOptions read_options_;
+  bool enable_verify_ghost_ = false;
+  Status status_;
+  Direction direction_ = Direction::kUnknown;
+  std::unordered_set<std::string> seen_forward_;
+  std::unordered_set<std::string> seen_reverse_;
+  bool current_prepared_ = false;
+  bool current_materialized_ = false;
+  bool current_applicable_ = false;
+  bool current_was_ghost_ = false;
+  std::string materialized_value_;
+  std::string canonical_key_;
+};
