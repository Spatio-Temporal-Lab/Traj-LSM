+  if (normalized >= 1.0f) {
+    return kSpatioTemporalBitmapGridSize - 1;
+  }
+  const float scaled =
+      normalized * static_cast<float>(kSpatioTemporalBitmapGridSize);
+  uint32_t cell = static_cast<uint32_t>(scaled);
+  if (cell >= kSpatioTemporalBitmapGridSize) {
