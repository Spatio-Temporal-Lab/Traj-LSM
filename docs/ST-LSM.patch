+        (new_area - old_area) / std::max(old_area, kAreaEps);
+    if (expansion_ratio_ > 0.0 && expansion >= expansion_ratio_) {
+      pending_first_valid_ = false;
+      SeedTrackerFromIncomingMeta(bucket_id, incoming);
+      return true;
+    }
+
+    tracker_mbr_ = merged;
+    return false;
+  }
